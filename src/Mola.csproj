<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 her Windows 10/11'de hazır gelir: tek exe, kurulum gerekmez. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>Mola</AssemblyName>
    <RootNamespace>Mola</RootNamespace>
    <ApplicationIcon>Mola.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Sürüm bilgisine git kayıt numarası eklenmesin: aynı kaynaktan her yerde aynı exe çıksın. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Mola</Product>
    <AssemblyTitle>Mola</AssemblyTitle>
    <Company>MPolat</Company>
    <Copyright>© 2026 MPolat</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Mola.ico" />
  </ItemGroup>

</Project>
